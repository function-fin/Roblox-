local radiusTotal = WHEEL_SIZE / 2
local innerRadius = radiusTotal * CENTER_RATIO
local outerRadius = radiusTotal
local slotLabelRadius = (innerRadius + outerRadius) / 2
local TOTAL_SLOTS = 8
local SLICE_ANGLE = 360 / TOTAL_SLOTS

for i = 1, TOTAL_SLOTS do
    local dividerAngleDeg = -90 + ((i - 1) * SLICE_ANGLE) - (SLICE_ANGLE / 2)
    local dividerAngleRad = math.rad(dividerAngleDeg)

    local x1 = radiusTotal + math.cos(dividerAngleRad) * innerRadius
    local y1 = radiusTotal + math.sin(dividerAngleRad) * innerRadius
    local x2 = radiusTotal + math.cos(dividerAngleRad) * outerRadius
    local y2 = radiusTotal + math.sin(dividerAngleRad) * outerRadius

    local dx, dy = x2 - x1, y2 - y1
    local lineLength = math.sqrt(dx * dx + dy * dy)
    local lineAngle = math.deg(math.atan2(dy, dx))

    local line = Instance.new("Frame")
    line.Size = UDim2.new(0, lineLength, 0, 2)
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Position = UDim2.new(0, (x1 + x2) / 2, 0, (y1 + y2) / 2)
    line.Rotation = lineAngle
    line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    line.BorderSizePixel = 0
    line.ZIndex = 3
    line.Parent = wheelFrame
end

local HOVER_COLOR = Color3.fromRGB(120, 120, 120)
local HOVER_TRANSPARENCY = 0.2
local SELECT_COLOR = Color3.fromRGB(120, 120, 120)
local SELECT_TRANSPARENCY = 0.2

local sectorSlices = {}
for i = 1, TOTAL_SLOTS do sectorSlices[i] = {} end

local function angleToSector(angleDeg)
    local corrected = (angleDeg + 90 + (SLICE_ANGLE / 2)) % 360
    return math.floor(corrected / SLICE_ANGLE) + 1
end

local SLICE_STEP = 2
for rowOffset = 0, (radiusTotal * 2) - 1, SLICE_STEP do
    local yPix = rowOffset - radiusTotal
    local currentSector = nil
    local startX = nil

    for colOffset = 0, (radiusTotal * 2) - 1 do
        local xPix = colOffset - radiusTotal
        local dist = math.sqrt(xPix * xPix + yPix * yPix)
        local sector = nil
        if dist >= innerRadius and dist <= outerRadius then
            local angleDeg = math.deg(math.atan2(yPix, xPix))
            sector = angleToSector(angleDeg)
        end

        if sector ~= currentSector then
            if currentSector then
                local frame = Instance.new("Frame")
                frame.BorderSizePixel = 0; frame.BackgroundColor3 = HOVER_COLOR; frame.BackgroundTransparency = 1
                frame.Position = UDim2.fromOffset(startX, rowOffset)
                frame.Size = UDim2.fromOffset((colOffset - startX) + 0.5, SLICE_STEP + 0.5)
                frame.ZIndex = 2; frame.Parent = wheelFrame
                table.insert(sectorSlices[currentSector], frame)
            end
            currentSector = sector; startX = colOffset
        end
    end
    if currentSector then
        local frame = Instance.new("Frame")
        frame.BorderSizePixel = 0; frame.BackgroundColor3 = HOVER_COLOR; frame.BackgroundTransparency = 1
        frame.Position = UDim2.fromOffset(startX, rowOffset)
        frame.Size = UDim2.fromOffset(((radiusTotal * 2) - startX) + 0.5, SLICE_STEP + 0.5)
        frame.ZIndex = 2; frame.Parent = wheelFrame
        table.insert(sectorSlices[currentSector], frame)
    end
end

local hoveredIndex = nil
local selectedIndex = nil
local lastHovered = nil
local lastSelected = nil

local function applySectorVisual(index)
    if not index then return end
    local isSelected = (index == selectedIndex)
    local isHovered = (index == hoveredIndex)

    local targetTransparency = 1
    if isSelected then targetTransparency = SELECT_TRANSPARENCY
    elseif isHovered then targetTransparency = HOVER_TRANSPARENCY end

    for _, frame in ipairs(sectorSlices[index] or {}) do
        TweenService:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            BackgroundTransparency = targetTransparency
        }):Play()
    end
end

local function renderRadialState()
    local changed = {}
    if lastHovered then changed[lastHovered] = true end
    if lastSelected then changed[lastSelected] = true end
    if hoveredIndex then changed[hoveredIndex] = true end
    if selectedIndex then changed[selectedIndex] = true end
    for i in pairs(changed) do applySectorVisual(i) end
    lastHovered = hoveredIndex; lastSelected = selectedIndex
end

local function getSectorFromPosition(position)
    if not wheelFrame or not wheelFrame.Visible then return nil end
    local abs = wheelFrame.AbsolutePosition; local size = wheelFrame.AbsoluteSize
    local center = Vector2.new(abs.X + size.X / 2, abs.Y + size.Y / 2)
    local dx = position.X - center.X; local dy = position.Y - center.Y
    local dist = math.sqrt(dx * dx + dy * dy)
    if dist < innerRadius - 2 or dist > outerRadius + 2 then return nil end
    return angleToSector(math.deg(math.atan2(dy, dx)))
end

