loadPage = function(targetPage)
    searchToken = searchToken + 1
    local myToken = searchToken
    local localCount = applySearchLocal(currentKeyword)

    if currentCategory ~= "All" then
        local catSet = {}
        for _, cat in ipairs(emoteData.categories) do
            if cat.name == currentCategory then
                for _, entry in ipairs(cat.emotes) do
                    local eid = type(entry) == "table" and tostring(entry.id or entry) or tostring(entry)
                    catSet[eid] = true
                end
                break
            end
        end
        local filtered = {}
        for _, e in ipairs(filteredEmotes) do
            local eid = tostring(e.id or e.AssetId or e.Id)
            if catSet[eid] then table.insert(filtered, e) end
        end
        
        if currentCategory ~= "All" then
            local catEmotesOrder = {}
            for _, cat in ipairs(emoteData.categories) do
                if cat.name == currentCategory then
                    for _, entry in ipairs(cat.emotes) do
                        local eid = type(entry) == "table" and tostring(entry.id or entry) or tostring(entry)
                        local originalEmote = emoteIndexById[eid]
                        if originalEmote then
                            table.insert(catEmotesOrder, originalEmote)
                        elseif type(entry) == "table" then
                            table.insert(catEmotesOrder, {id = entry.id, name = entry.name})
                        end
                    end
                    break
                end
            end
            if #catEmotesOrder > 0 then
                filtered = catEmotesOrder
            end
        end
        
        filteredEmotes = filtered; localCount = #filteredEmotes
    end

    totalPages = math.max(1, math.ceil(localCount / 8))
    if targetPage > totalPages then targetPage = totalPages end
    if targetPage < 1 then targetPage = 1 end
    currentPage = targetPage
    pageTextBox.Text = tostring(currentPage)
    pageInfoLabel.Text = tostring(totalPages)

    selectedIndex = nil
    hoveredIndex = nil

    catalogItems = {}
    local startIdx = (currentPage - 1) * 8 + 1
    for j = 0, 7 do
        if filteredEmotes[startIdx + j] then table.insert(catalogItems, filteredEmotes[startIdx + j]) end
    end
    updateWheelSlots()
    renderRadialState()

    if localCount < 8 and currentKeyword ~= "" and currentCategory == "All" then
        task.spawn(function()
            local apiList = FetchFromAPI(currentKeyword)
            if myToken ~= searchToken then return end
            if #apiList > 0 then
                local merged = mergeNoDupes(filteredEmotes, apiList)
                filteredEmotes = merged; totalPages = math.max(1, math.ceil(#merged / 8))
                local added = false
                for _, novo in ipairs(apiList) do
                    if not emoteIndexById[tostring(novo.id)] then table.insert(allEmotes, novo); emoteIndexById[tostring(novo.id)] = novo; added = true end
                end
                if added then SaveJSON(EMOTE_CACHE_FILE, allEmotes) end
                if targetPage > totalPages then targetPage = totalPages end
                currentPage = targetPage
                pageTextBox.Text = tostring(currentPage)
                pageInfoLabel.Text = tostring(totalPages)
                catalogItems = {}
                local newStart = (currentPage - 1) * 8 + 1
                for j = 0, 7 do if filteredEmotes[newStart + j] then table.insert(catalogItems, filteredEmotes[newStart + j]) end end
                updateWheelSlots()
            end
        end)
    end
end

