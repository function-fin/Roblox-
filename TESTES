local function RebuildIndex()
    emoteIndexById = {}
    for _, e in ipairs(allEmotes) do emoteIndexById[tostring(e.id)] = e end
end

local function FetchFromAPI(keyword)
    local out = {}
    local ok, pages = pcall(function()
        local params = CatalogSearchParams.new()
        params.SearchKeyword = keyword or ""
        params.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        params.SortType = Enum.CatalogSortType.RecentlyCreated
        params.Limit = 120
        return AvatarEditorService:SearchCatalog(params)
    end)
    if ok and pages then
        local s, list = pcall(function() return pages:GetCurrentPage() end)
        if s and list then
            for _, v in ipairs(list) do
                local id = tonumber(v.Id or v.AssetId)
                if id then table.insert(out, {id = id, name = v.Name or ("Emote_" .. id)}) end
            end
        end
    end
    return out
end

local function smartSearchMatch(name, term)
    if not term or term == "" then return true end
    name = tostring(name):lower()
    term = tostring(term):lower()
    for word in term:gmatch("%S+") do
        if not name:find(word, 1, true) then return false end
    end
    return true
end

local function applySearchLocal(term)
    term = tostring(term or ""):lower()
    local out = {}
    if term == "" then
        out = allEmotes
    else
        local isId = term:match("^%d+$")
        if isId then
            local item = emoteIndexById[term]
            if item then out = {item} else out = {} end
        else
            for _, e in ipairs(allEmotes) do
                if smartSearchMatch(e.name, term) then table.insert(out, e) end
            end
        end
    end

    local starredSet = {}
    for i, id in ipairs(starredEmotes) do starredSet[tostring(id)] = i end
    
    local starredList, normalList = {}, {}
    for _, e in ipairs(out) do
        if starredSet[tostring(e.id)] then table.insert(starredList, e) else table.insert(normalList, e) end
    end
    
    table.sort(starredList, function(a, b)
        return (starredSet[tostring(a.id)] or 9999) < (starredSet[tostring(b.id)] or 9999)
    end)

    filteredEmotes = {}
    for _, e in ipairs(starredList) do table.insert(filteredEmotes, e) end
    for _, e in ipairs(normalList) do table.insert(filteredEmotes, e) end
    
    return #filteredEmotes
end

