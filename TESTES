local function LoadJSON(fileName, fallback)
    ensureFolder()
    if isfile and isfile(fileName) then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(fileName)) end)
        if ok and type(decoded) == "table" then return decoded end
    end
    return fallback
end

local function SaveJSON(fileName, data)
    ensureFolder()
    if writefile then pcall(function() writefile(fileName, HttpService:JSONEncode(data)) end) end
end

local cached = LoadJSON(EMOTE_CACHE_FILE, nil)
