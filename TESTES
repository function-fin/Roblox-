local function promptRenameCategory(oldName)
    local targetBtn = nil
    for _, child in ipairs(sideScrolling:GetChildren()) do
        if child:IsA("TextButton") and child:GetAttribute("CategoryName") == oldName then targetBtn = child; break end
    end
    if not targetBtn then return end
    local titleLabel = targetBtn:FindFirstChild("CatTitle")
    if not titleLabel then return end

    local textBox = Instance.new("TextBox")
    textBox.Size = titleLabel.Size; textBox.Position = titleLabel.Position
    textBox.BackgroundTransparency = 1; textBox.Text = oldName
    textBox.TextColor3 = titleLabel.TextColor3; textBox.TextSize = titleLabel.TextSize
    textBox.Font = titleLabel.Font; textBox.TextXAlignment = titleLabel.TextXAlignment
    textBox.ClearTextOnFocus = false; textBox.Parent = targetBtn
    titleLabel.Visible = false; textBox:CaptureFocus()

    local finished = false
    local function finishRename(commit)
        if finished then return end; finished = true
        if commit and textBox.Text ~= "" then
            local newName = textBox.Text
            for _, cat in ipairs(emoteData.categories) do if cat.name == oldName then cat.name = newName break end end
            if currentCategory == oldName then currentCategory = newName end
            SaveJSON(CATEGORIES_FILE, emoteData)
        end
        textBox:Destroy(); buildCategoriesMenu()
    end
    textBox.FocusLost:Connect(function(enterPressed) finishRename(enterPressed) end)
end

