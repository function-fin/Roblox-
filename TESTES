-- ===== Setores (pixel-run) =====
local sectorParts = {}
for i = 1, SECTOR_COUNT do sectorParts[i] = {} end

local function createSectorRun(index, row, startColumn, endColumn)
    local frame = Instance.new("Frame")
    frame.Name = "Sector_" .. index
    frame.BorderSizePixel = 0
    frame.BackgroundColor3 = COLORS.Normal
    frame.BackgroundTransparency = 0.08
    frame.Position = UDim2.fromOffset(startColumn * CELL_SIZE, row * CELL_SIZE)
    frame.Size = UDim2.fromOffset((endColumn - startColumn + 1) * CELL_SIZE + 0.2, CELL_SIZE + 0.2)
    frame.ZIndex = 2
    frame.Parent = wheelFrame
    table.insert(sectorParts[index], frame)
end

local columns = math.floor(WHEEL_SIZE / CELL_SIZE)
local rows = math.floor(WHEEL_SIZE / CELL_SIZE)

for row = 0, rows - 1 do
    local currentSector = nil
    local startColumn = nil
    local y = -RADIUS + (row + 0.5) * CELL_SIZE
    for column = 0, columns - 1 do
        local x = -RADIUS + (column + 0.5) * CELL_SIZE
        local distance = math.sqrt(x * x + y * y)
        local sector = nil
        if distance >= INNER_RADIUS and distance <= OUTER_RADIUS then
            local angle = math.deg(math.atan2(y, x))
            local correctedAngle = (angle + 90 + (SECTOR_ANGLE / 2)) % 360
            sector = math.floor(correctedAngle / SECTOR_ANGLE) + 1
        end
        if sector ~= currentSector then
            if currentSector then
                createSectorRun(currentSector, row, startColumn, column - 1)
            end
            currentSector = sector
            startColumn = column
        end
    end
    if currentSector then
        createSectorRun(currentSector, row, startColumn, columns - 1)
    end
end

