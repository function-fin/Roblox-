local function FetchFromGitHub()
    local ok, result = pcall(function()
        local json = game:HttpGet(GITHUB_URL)
        if json and json ~= "" then
            return HttpService:JSONDecode(json)
        end
        return nil
    end)
    if ok and result and result.data then
        local out = {}
        for _, item in ipairs(result.data) do
            local id = tonumber(item.id)
            if id and id > 0 then
                table.insert(out, {id = id, name = item.name or ("Emote_" .. id)})
            end
        end
        if #out > 0 then return out end
    end
    return nil
end

local function FetchFromAPI(keyword)
    local out = {}
    local ok, pages = pcall(function()
        local params = CatalogSearchParams.new()
        params.SearchKeyword = keyword or ""
        params.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
        params.SortType = Enum.CatalogSortType.RecentlyCreated
        params.Limit = 120
        return AvatarEditorService:SearchCatalog(params)
    end)
    if ok and pages then
        local s, list = pcall(function() return pages:GetCurrentPage() end)
        if s and list then
            for _, v in ipairs(list) do
                local id = tonumber(v.Id or v.AssetId)
                if id then
                    table.insert(out, {id = id, name = v.Name or ("Emote_" .. id)})
                end
            end
        end
    end
    return out
end

local function RebuildIndex()
    emoteIndexById = {}
    for _, e in ipairs(allEmotes) do
        emoteIndexById[tostring(e.id)] = e
    end
end

local function smartSearchMatch(name, term)
    if not term or term == "" then return true end
    name = tostring(name):lower()
    term = tostring(term):lower()
    for word in term:gmatch("%S+") do
        if not name:find(word, 1, true) then return false end
    end
    return true
end

local function applySearchLocal(term)
    term = tostring(term or ""):lower()
    if term == "" then
        filteredEmotes = allEmotes
        return #filteredEmotes
    end
    local isId = term:match("^%d+$")
    if isId then
        local item = emoteIndexById[term]
        if item then
            filteredEmotes = {item}
            return 1
        end
        filteredEmotes = {}
        return 0
    end
    local out = {}
    for _, e in ipairs(allEmotes) do
        if smartSearchMatch(e.name, term) then
            table.insert(out, e)
        end
    end
    filteredEmotes = out
    return #out
end

local function mergeNoDupes(listA, listB)
    local seen = {}
    local out = {}
    for _, e in ipairs(listA) do
        local k = tostring(e.id)
        if not seen[k] then seen[k] = true; table.insert(out, e) end
    end
    for _, e in ipairs(listB) do
        local k = tostring(e.id)
        if not seen[k] then seen[k] = true; table.insert(out, e) end
    end
    return out
end

local function getEmoteName(id)
