-- ==========================================
-- HIT-TEST ANGULAR (clique na roda por setor)
-- Complementa o clique individual dos slots:
--   • Funciona mesmo em áreas "mortas" entre botões
--   • Respeita deadzone central
--   • Detecta clique no setor pelo ângulo real
-- ==========================================
trackConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    if not mainContainer.Visible then return end
    if saveModal.Visible then return end
    if sidePanel.Visible then return end

    local absPos = wheelFrame.AbsolutePosition
    local absSize = wheelFrame.AbsoluteSize
    local pos = Vector2.new(input.Position.X, input.Position.Y)

    if pos.X < absPos.X or pos.X > absPos.X + absSize.X
        or pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
        return
    end

    local center = absPos + absSize / 2
    local dx, dy = pos.X - center.X, pos.Y - center.Y
    local dist = math.sqrt(dx * dx + dy * dy)
    local radius = math.min(absSize.X, absSize.Y) * 0.5

    if dist > radius then return end

    local deadzone = radius * 0.2
    if dist < deadzone then return end

    local angle = math.deg(math.atan2(dy, dx))
    local corrected = (angle + 90 + (SLICE_ANGLE / 2)) % 360
    local index = math.floor(corrected / SLICE_ANGLE) + 1

    if index < 1 then index = 1 end
    if index > TOTAL_SLOTS then index = TOTAL_SLOTS end

    selectSlotIndex(index)
end))

local function updateWheelSlots()
    for i = 1, TOTAL_SLOTS do
        local item = catalogItems[i]
        local img = slotImages[i]
        local txt = slotTexts[i]
        local hl = slotHighlights[i]

        if hl then
            TweenService:Create(hl, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
        end

        if item then
            txt.Visible = false
            local eid = item.id or item.AssetId or item.Id
            img.Image = "rbxthumb://type=Asset&id=" .. tostring(eid) .. "&w=150&h=150"
            img.Visible = true
        else
            txt.Visible = true
            img.Image = ""
            img.Visible = false
        end
    end
end

