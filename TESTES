-- ===== Estilo dos setores (hover/selected) =====
local selectedIndex = nil
local hoveredIndex = nil
local lastSelected = nil
local lastHovered = nil

local function updateSectorStyle(index)
    local color = COLORS.Normal
    local transparency = 0.08
    if index == selectedIndex then
        color = COLORS.Selected
        transparency = 0.08
    elseif index == hoveredIndex then
        color = COLORS.Hover
        transparency = 0.2
    end
    for _, part in ipairs(sectorParts[index]) do
        part.BackgroundColor3 = color
        part.BackgroundTransparency = transparency
    end
    local txt = slotTexts[index]
    if txt then
        if index == selectedIndex then
            txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        elseif index == hoveredIndex then
            txt.TextColor3 = COLORS.TextDark
        else
            txt.TextColor3 = COLORS.Text
        end
    end
end

local function renderState()
    local changed = {}
    if lastSelected then changed[lastSelected] = true end
    if lastHovered then changed[lastHovered] = true end
    if selectedIndex then changed[selectedIndex] = true end
    if hoveredIndex then changed[hoveredIndex] = true end
    for index in pairs(changed) do
        updateSectorStyle(index)
    end
    lastSelected = selectedIndex
    lastHovered = hoveredIndex
end

local function getSectorFromPosition(position)
    local center = wheelFrame.AbsolutePosition + (wheelFrame.AbsoluteSize / 2)
    local dx = position.X - center.X
    local dy = position.Y - center.Y
    local distance = math.sqrt(dx * dx + dy * dy)
    if distance < INNER_RADIUS or distance > OUTER_RADIUS then return nil end
    local angle = math.deg(math.atan2(dy, dx))
    local correctedAngle = (angle + 90 + (SECTOR_ANGLE / 2)) % 360
    local index = math.floor(correctedAngle / SECTOR_ANGLE) + 1
    return math.clamp(index, 1, SECTOR_COUNT)
end

UserInputService.InputChanged:Connect(function(input)
