--// TRACK (Comportamento do 7yd7 - Sem forçar prioridade, mistura natural)
local function LoadTrack(id)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local numId = tonumber(id)
    if not numId then return end

    pcall(function()
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            
            -- Limita a 6 animações simultâneas para não crashar o Roblox
            if #ActiveTracks >= 6 then
                local oldestTrack = table.remove(ActiveTracks, 1)
                if oldestTrack and oldestTrack.IsPlaying then
                    oldestTrack:Stop(0.1)
                end
            end

            local animId
            local ok, result = pcall(function() return game:GetObjects("rbxassetid://" .. tostring(numId)) end)
            if ok and result and #result > 0 and result[1]:IsA("Animation") then
                animId = result[1].AnimationId
            else
                animId = "rbxassetid://" .. tostring(numId)
            end

            local anim = Instance.new("Animation")
            anim.AnimationId = animId
            local track = animator:LoadAnimation(anim)
            
            -- IMPORTANTE: Nenhuma definição de Priority ou Weight.
            -- Deixamos o Roblox usar o padrão (Core) para permitir a mesclagem natural igual ao 7yd7.
            track.Looped = true
            track:Play(0.1, 1, Settings.Speed)
            
            table.insert(ActiveTracks, track)
        end
    end)
end

