local function mergeNoDupes(listA, listB)
    local seen, out = {}, {}
    for _, e in ipairs(listA) do local k = tostring(e.id); if not seen[k] then seen[k] = true; table.insert(out, e) end end
    for _, e in ipairs(listB) do local k = tostring(e.id); if not seen[k] then seen[k] = true; table.insert(out, e) end end
    return out
end

